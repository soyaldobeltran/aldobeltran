---
import Layout from "../layouts/Layout.astro";
import portada_founders from "../../public/images/founders/portada_founders.png";
import { Image } from "astro:assets";
---

<Layout
  description="Atelier digital de Aldo Beltrán. Creación de presencias sobrias y elegantes, donde la calma y el detalle se convierten en arte."
  title="Aldo Beltrán | Diseño con Calma"
  keywords="Aldo Beltrán, diseño con calma, lujo sobrio, elegancia digital, diseñador web minimalista, presencia estética"
>
  <main>
    <section
      class="mask-b-from-20% mask-b-to-80% bg-[url(../../public/images/founders/portada_founders.png)] bg-cover bg-center w-screen h-screen flex items-center justify-start px-4 md:px-36 mask-l-from-50% mask-l-to-90%"
    >
      <article>
        <h1 class="text-6xl font-medium text-white drop-shadow-lg md:text-8xl">
          The <br /> Founders <br /> Edition
        </h1>
        <div class="text-white drop-shadow-lg mt-8">
          <p
            class="text-2xl font-normal border-b-2 border-white py-2 tracking-widest"
          >
            SIGNATURE COLLECTION
          </p>
          <p class="text-xl font-light pt-2">TULUM - RIVIERA MAYA</p>
        </div>
      </article>
    </section>
  </main>
</Layout>
